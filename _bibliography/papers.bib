@article{lu2026bifurcation,
  abbr={Chaos, Solitons & Fractals},
  preview={csf.png},
  title={Bifurcation mechanisms and FPGA implementation of comb-shaped chaos and coexisting behaviors in a modified Hindmarsh-Rose model},
  author={Lu, Shenfan and Cao, Ben and Zhang, Hengming and Liu, Wangyu},
  journal={Chaos, Solitons \& Fractals},
  volume={208},
  pages={118233},
  year={2026},
  publisher={Elsevier},
  doi={10.1016/j.chaos.2026.118233},
  html={https://doi.org/10.1016/j.chaos.2026.118233},
  note={<span class='paper-abstract'>The edge of chaos is regarded as a critical regime for neuronal complexity, learning, and adaptability. In Hindmarsh-Rose type models, this regime manifests as comb-shaped chaotic regions in two-dimensional parameter space. Although the phenomenon has been widely observed, the specific types of bifurcation points and structures that underlie it remain unclear. This paper investigates the bifurcation mechanisms underlying comb-shaped chaos and the dynamics of different coexisting behaviors related to bifurcations in a modified HR model. The results indicate that, as a single parameter varies, the neuron exhibits an alternation between periodic and chaotic firings. This can be explained by the special bifurcation structure to an alternation between fold bifurcations of limit cycles (Flc) and period-doubling bifurcations (PD), where Flc leads to periodic firing and PD leads to chaotic firing, in a repeating sequence. In the two-dimensional parameter space, comb-shaped chaos can be well explained by the alternation of periodic and chaotic regions formed by codimension-1 bifurcation curves of Flc and PD. Additionally, three types of coexisting behaviors are identified: two spiking states associated with supercritical Hopf and homoclinic bifurcations, chaos and resting associated with subcritical Hopf bifurcation, and a hidden coexistence of two bursting states related to PD bifurcations. The coexisting behaviors are explained by fast-slow variable dissection. These findings are validated through hardware implementation using a Field-Programmable Gate Array (FPGA), which successfully observes the alternation of periodic and chaotic firing and the three coexistence behaviors. This study elucidates the bifurcation mechanisms of comb-shaped chaos and coexistence dynamics, and demonstrates their physical realizability, laying a foundation for biologically realistic neuromorphic computing.</span>},
  selected={true}
}

@article{cao2027dynamic,
  abbr={Chaos, Solitons & Fractals},
  preview={csf.png},
  title={Dynamic mechanisms of post-inhibitory rebound in central pattern generator for rapid initiation and bilaterally coordinated locomotion},
  author={Cao, Ben and Su, Zhaoru and Lu, Shenfan and Gu, Huaguang},
  journal={Chaos, Solitons \& Fractals},
  volume={214},
  pages={119523},
  year={2027},
  publisher={Pergamon},
  doi={10.1016/j.chaos.2026.119523},
  html={https://www.sciencedirect.com/science/article/pii/S0960077926016644},
  note={<span class='paper-abstract'>Post-inhibitory rebound (PIR) is a counterintuitive phenomenon in which inhibition, instead of suppressing firing, paradoxically enhances it upon release. PIR has been observed in zebrafish spinal central pattern generators (CPGs), yet its dynamical role in rapid and coordinated locomotion remains unclear. A bilaterally symmetric single-segment CPG model is constructed, in which bifurcation analysis guides the parameter assignment for four neuronal types (V2a, V1, MN, dI6) to match their distinct physiological roles. Three dynamical roles of PIR within this network are identified. First, for rapid initiation, disinhibition of resting V2a pacemaker neurons triggers PIR and increasing the conductance of hyperpolarization-activated cation current (Ih) shortens both PIR latency and locomotor onset via enhanced Ih dynamics. Second, for low within-cycle response latency, during ongoing rhythm, stronger inhibition from the contralateral dI6 onto the ipsilateral MN paradoxically reduces MN firing latency, because stronger inhibition potentiates PIR upon subsequent disinhibition. Third, for stable bilateral coordination, increasing the conductance of Ih in V2a and MNs raises burst frequency and expands the parameter regime by enhancing PIR for robust anti-phase coordination, as quantified by phase differences. Furthermore, the modulatory role of the Ih current is also verified through hardware implementation via a microcontroller-unit-based digital circuit. These results establish Ih-mediated PIR as a key dynamical mechanism for low-latency and bilaterally coordinated locomotion, with broader implications for the biophysics of efficient motor control.</span>},
  selected={true}
}

@article{cao2026dynamics,
  abbr={Sci. China Technol. Sci.},
  preview={scts.png},
  title={The dynamics of special ion channel inspired memristive circuit and application in reproducing hippocampal neuronal firing},
  author={Cao, Ben and Ma, Mengzi and Lu, Shenfan and Cen, Xiaoliang and Li, Chunbiao},
  journal={Science China Technological Sciences},
  volume={69},
  number={6},
  year={2026},
  doi={10.1007/s11431-025-3291-6},
  html={http://engine.scichina.com/doi/10.1007/s11431-025-3291-6},
  note={<span class='paper-abstract'>Designing neuromorphic circuits with higher biological plausibility is 
crucial for brain-inspired intelligence [1]. Memristors, as novel fundamental 
circuit elements, have shown great potential in neuromorphic circuits, par
ticularly in emulating the ion channels and synapses of biological neurons 
[2]. Memristors that mimic conventional ion channels (such as potassium 
and sodium) have enabled basic neuronal firing [3,4]. However, achieving 
complex neuronal firing related to important physiological functions re
mains a challenge. These complex firing patterns are often associated with 
special ion channels and require memristors and neuromorphic circuits that 
emulate these specific ion channels. </span>},
  selected={true}
}

@article{cao2026multiscale,
  abbr={Chaos},
  preview={chaos.png},
  title={Multiscale dynamics of special memristive ion channels in a neural circuit},
  author={Cao, Ben and Ma, Mengzi and Lu, Shenfan and Li, Chunbiao},
  journal={Chaos: An Interdisciplinary Journal of Nonlinear Science},
  volume={36},
  number={7},
  pages={073107},
  year={2026},
  publisher={AIP Publishing},
  doi={10.1063/5.0337858},
  html={https://pubs.aip.org/aip/cha/article-abstract/36/7/073107/3397596/Multiscale-dynamics-of-special-memristive-ion?redirectedFrom=fulltext},
  note={<span class='paper-abstract'>The multiscale dynamics of the nervous system are crucial for functions such as computation and memory. This paper investigates the multiscale dynamics of special memristive ion channels containing T-type calcium and afterhyperpolarization (AHP) in a neural circuit. The T-type calcium channel, AHP channel, and potassium channel are represented by a first-order locally active memristor (LAM), a second-order LAM, and a first-order passive memristor, respectively. The sodium channel is represented by a voltage-dependent nonlinear resistor. The results show that two resistance parameters regulating the timescales of T-type calcium and AHP ion channel memristors modulate rich dynamical behaviors including fast spiking, chaotic spiking (CS), continuous bursting (CB), intrinsic bursting (IB), and chaotic bursting (CB). Additionally, the dynamics of two types of coexisting behaviors are obtained: the coexistence of two periodic bursting patterns, and the coexistence of periodic and chaotic bursting. Subsequently, using fast–slow variable dissection with two slow variables, the fast–slow dynamics and bifurcation mechanisms of CB and IB are identified in the codimension-2 plane. Specifically, within one period, CB initiates at a saddle-node bifurcation on an invariant circle and terminates at a Hopf bifurcation, while IB both initiates and terminates at Hopf bifurcations. Finally, the analog circuit of the neural circuit is designed and implemented on the LTspice simulation platform and digital circuits based on CH32 microcontrollers, validating the simulation and theoretical results of multiscale dynamics. These findings elucidate the multiscale dynamics of memristive ion channels influencing neuronal firing patterns, providing a theoretical and hardware foundation for neuromorphic computing.</span>},
  selected={true}
}
